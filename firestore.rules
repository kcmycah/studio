rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if the user owns a document directly
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: check if parent system is owned by the user
    // Used for subcollection security in ai_systems/{systemId}/assessments/{assessmentId}
    function isSystemOwner(systemId) {
      let systemPath = /databases/$(database)/documents/ai_systems/$(systemId);
      return request.auth != null && get(systemPath).data.userId == request.auth.uid;
    }

    // AI systems - Top-level user owned
    match /ai_systems/{systemId} {
      allow read, write, delete: if isOwner(resource.data.userId);
      allow create: if request.auth != null && isOwner(request.resource.data.userId);

      // Assessments subcollection – restricted via parent system ownership
      match /assessments/{assessmentId} {
        allow read, write, delete: if isSystemOwner(systemId);
        allow create: if request.auth != null && 
          isOwner(request.resource.data.userId) && 
          request.resource.data.systemId == systemId;
        
        // Allow listing within the specific system context
        allow list: if request.auth != null && isSystemOwner(systemId);
      }
    }

    // testRuns – direct ownership field for efficient cross-system lookups
    match /testRuns/{document} {
      allow read, write, delete: if isOwner(resource.data.userId);
      allow create: if request.auth != null && isOwner(request.resource.data.userId);
      allow list: if request.auth != null && 
        request.query.filters.some(f => f.field == 'userId' && f.op == '==' && f.value == request.auth.uid);
    }

    // users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }

    // feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, list: if request.auth != null && (isOwner(resource.data.userId) || isOwner(request.auth.uid));
    }
  }
}
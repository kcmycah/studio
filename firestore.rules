
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if the user owns a document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // AI systems
    match /ai_systems/{systemId} {
      allow read, write, delete: if isOwner(resource.data.userId);
      allow create: if request.auth != null && isOwner(request.resource.data.userId);

      // Assessments subcollection – scoped to the system owner
      match /assessments/{assessmentId} {
        allow read, write, delete: if isOwner(get(/databases/$(database)/documents/ai_systems/$(systemId)).data.userId);
        allow create: if request.auth != null && isOwner(request.resource.data.userId);
      }
    }

    // testRuns – simplified to direct ownership
    match /testRuns/{document} {
      allow read: if isOwner(resource.data.userId);
      allow write: if request.auth != null;
    }

    // user_preferences
    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }

    // feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if isOwner(resource.data.userId);
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if the user owns a document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // AI systems
    match /ai_systems/{document} {
      allow read, write: if isOwner(resource.data.userId);
    }

    // Assessments – the problematic collection
    match /assessments/{document} {
      allow read: if isOwner(resource.data.userId);
      allow write: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    // disa_assessments (if you use it)
    match /disa_assessments/{document} {
      allow read: if isOwner(resource.data.userId);
      allow write: if isOwner(resource.data.userId);
    }

    // testRuns
    match /testRuns/{document} {
      allow read: if resource.data.userId == request.auth.uid;
      allow write: if request.auth != null;
    }

    // user_preferences
    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
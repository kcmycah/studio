
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if the user owns a document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: check if parent system is owned by user
    function isSystemOwner(systemId) {
      return request.auth != null && get(/databases/$(database)/documents/ai_systems/$(systemId)).data.userId == request.auth.uid;
    }

    // AI systems
    match /ai_systems/{systemId} {
      allow read, write, delete: if isOwner(resource.data.userId);
      allow create: if request.auth != null && isOwner(request.resource.data.userId);

      // Assessments subcollection – restricted via parent system ownership
      match /assessments/{assessmentId} {
        allow read, write, delete: if isSystemOwner(systemId);
        allow create: if request.auth != null && isOwner(request.resource.data.userId) && request.resource.data.systemId == systemId;
      }
    }

    // testRuns – direct ownership field
    match /testRuns/{document} {
      allow read: if isOwner(resource.data.userId);
      allow create: if request.auth != null && isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // user_preferences
    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }

    // feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if isOwner(resource.data.userId);
    }
  }
}

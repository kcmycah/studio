
{
  "entities": {
    "AISystem": {
      "title": "AI System",
      "description": "An AI endpoint or assistant being monitored for accessibility.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string", "enum": ["Chatbot", "Voice Assistant"] },
        "createdAt": { "type": "object", "format": "date-time" }
      },
      "required": ["userId", "name", "url", "type"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "A specific audit run for an AI system covering four DISA domains.",
      "type": "object",
      "properties": {
        "systemId": { "type": "string" },
        "userId": { "type": "string" },
        "version": { "type": "string" },
        "overallScore": { "type": "number" },
        "domainScores": {
          "type": "object",
          "properties": {
            "accessibility": { "type": "number" },
            "biasRisk": { "type": "number" },
            "transparency": { "type": "number" },
            "equityData": { "type": "number" }
          }
        },
        "details": {
          "type": "object",
          "properties": {
            "biasExplanation": { "type": "string" },
            "crawledAt": { "type": "string", "format": "date-time" }
          }
        },
        "createdAt": { "type": "object", "format": "date-time" }
      },
      "required": ["systemId", "userId", "overallScore", "version"]
    },
    "TestRun": {
      "title": "Test Run",
      "description": "A per-persona breakdown of a specific assessment.",
      "type": "object",
      "properties": {
        "assessmentId": { "type": "string" },
        "systemId": { "type": "string" },
        "userId": { "type": "string" },
        "persona": { "type": "string" },
        "success": { "type": "boolean" },
        "accessibilityIssues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "impact": { "type": "string" },
              "description": { "type": "string" },
              "wcagLevel": { "type": "string", "enum": ["A", "AA", "AAA"] }
            }
          }
        },
        "createdAt": { "type": "object", "format": "date-time" }
      },
      "required": ["assessmentId", "systemId", "userId", "persona", "success"]
    },
    "User": {
      "title": "User Profile",
      "description": "Extended user data for monetization and settings.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "subscriptionStatus": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "lemonSqueezyCustomerId": { "type": "string" },
        "settings": {
          "type": "object",
          "properties": {
            "emailResults": { "type": "boolean" },
            "scheduledMonitor": { "type": "object" }
          }
        }
      }
    },
    "UserPreference": {
      "title": "User Preference",
      "description": "Persistent UI settings and filters for a user.",
      "type": "object",
      "properties": {
        "filters": {
          "type": "object",
          "properties": {
            "wcagLevels": { "type": "array", "items": { "type": "string" } },
            "severities": { "type": "array", "items": { "type": "string" } },
            "personas": { "type": "array", "items": { "type": "string" } },
            "onlyFailed": { "type": "boolean" },
            "onlyPassed": { "type": "boolean" }
          }
        },
        "dashboardView": { "type": "string", "enum": ["grid", "list"] },
        "updatedAt": { "type": "object", "format": "date-time" }
      }
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Accessibility feedback or issue report from a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "issue": { "type": "string" },
        "createdAt": { "type": "object", "format": "date-time" }
      },
      "required": ["userId", "issue", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and subscription data."
    },
    "/ai_systems/{systemId}": {
      "schema": "AISystem",
      "description": "Inventory of AI systems per user."
    },
    "/ai_systems/{systemId}/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "System-specific record of comprehensive DISA audits."
    },
    "/testRuns/{runId}": {
      "schema": "TestRun",
      "description": "Individual persona test results for an assessment."
    },
    "/user_preferences/{userId}": {
      "schema": "UserPreference",
      "description": "Persistent UI settings for a user."
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "User reported accessibility issues."
    }
  }
}
